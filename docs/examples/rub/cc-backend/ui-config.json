{
    "job-list": {
        "use-paging": false,
        "show-footprint": false
    },
    "job-view": {
        "show-polar-plot": true,
        "show-footprint": true,
        "show-roofline": true,
        "show-stat-table": true
    },
    "metric-config": {
        "job-list-metrics": [
            "cpu_load",
            "mem_bw",
            "flops_any"
        ],
        "job-view-plot-metrics": [
            "cpu_load",
            "mem_bw",
            "flops_any"
        ],
        "job-view-table-metrics": [
            "cpu_load",
            "mem_bw",
            "flops_any"
        ],
        "clusters": [
            {
                "name": "elysium",
                "sub-clusters": [
                    {
                        "name": "cpu",
                        "job-list-metrics": [
                            "cpu_load",
                            "mem_bw",
                            "flops_any"
                        ]
                    }
                ]
            }
        ]
    },
    "node-list": {
        "use-paging": true
    },
    "plot-configuration": {
        "plots-per-row": 3,
        "color-background": true,
        "line-width": 3,
        "color-scheme": [
            "#00bfff",
            "#0000ff",
            "#ff00ff",
            "#ff0000",
            "#ff8000",
            "#ffff00",
            "#80ff00"
        ]
    }
}

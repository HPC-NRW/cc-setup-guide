{
  "main": {
    "addr": "127.0.0.1:8443",
    "api-allowed-ips": [
      "__API_CLIENT_IP__"
    ],
    "short-running-jobs-duration": 30,
    "enable-job-taggers": false,
    "nodestate-retention": {
      "policy": "move",
      "target-kind": "file",
      "target-path": "./var/nodestate-archive"
    },
    "resampling": {
      "minimum-points": 600,
      "trigger": 180,
      "resolutions": [
        240,
        60
      ]
    }
  },
  "auth": {
    "jwts": {
      "max-age": ""
    }
  },
  "cron": {
    "commit-job-worker": "1m",
    "duration-worker": "5m",
    "footprint-worker": "10m"
  },
  "archive": {
    "kind": "file",
    "path": "/opt/monitoring/job-archive"
  },
  "metric-store": {
    "checkpoints": {
      "file-format": "json",
      "directory": "/opt/monitoring/cc-metric-store/var/checkpoints"
    },
    "memory-cap": 100,
    "retention-in-memory": "48h",
    "cleanup": {
      "mode": "archive",
      "directory": "/opt/monitoring/cc-metric-store/var/archive"
    }
  },
  "ui-file": "ui-config.json"
}

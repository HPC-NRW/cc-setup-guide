{
  "add_tags": [
    {
      "key": "cluster",
      "value": "elysium",
      "if": "*"
    }
  ],
  "interval_timestamp": false,
  "num_cache_intervals": 0,
  "process_messages": {
    "stage_order": [
      "add_tag",
      "rename",
      "rename_if",
      "drop_by_type",
      "drop_by_name",
      "drop_if",
      "add_meta",
      "change_unit_prefix",
      "normalize_unit"
    ],
    "hostname_tag": "hostname",
    "rename_messages": {
      "load_one": "cpu_load",
      "net_bytes_in_bw": "net_bytes_in",
      "net_bytes_out_bw": "net_bytes_out",
      "ib_recv_bw": "ib_recv",
      "ib_xmit_bw": "ib_xmit",
      "nv_fb_mem_used": "acc_mem_used",
      "nv_power_usage": "acc_power",
      "nfsio_nread_bw": "nfsio_nread",
      "nfsio_nwrite_bw": "nfsio_nwrite"
    },
    "rename_messages_if": {},
    "drop_messages_if": [
      "(tag.hostname startsWith 'cpu' || tag.hostname startsWith 'fatcpu' || tag.hostname startsWith 'gpu' || tag.hostname startsWith 'vis') && name == 'disk_free' && !(tag.device == '/dev/nvme0n1p4' || tag.device == 'nvme0n1p4')",
      "tag.hostname startsWith 'fatgpu' && name == 'disk_free' && !(tag.device == '/dev/md127' || tag.device == 'md127')",
      "tag.hostname startsWith 'tl40sgpu' && name == 'disk_free' && !(tag.device == '/dev/nvme0n1p1' || tag.device == 'nvme0n1p1')",
      "tag.hostname startsWith 'tvis' && name == 'disk_free' && !(tag.device == '/dev/md126' || tag.device == 'md126')",
      "tag.hostname startsWith 'tcpu' && name == 'disk_free' && !(tag.device == '/dev/sda4' || tag.device == 'sda4')",
      "tag.hostname == 'th200gpu001' && name == 'disk_free' && !(tag.device == '/dev/nvme0n1p1' || tag.device == 'nvme0n1p1')",
      "tag.hostname == 'h200gpu001' && name == 'disk_free' && !(tag.device == '/dev/nvme0n1p1' || tag.device == 'nvme0n1p1')",
      "name == 'nfsio_nread'  && !(tag.stypeid matches 'home:/home')",
      "name == 'nfsio_nwrite' && !(tag.stypeid matches 'home:/home')",
      "messagetype == 'metric' && !(name in ['cpu_load','cpu_load_core','mem_used','mem_bw','net_bytes_in','net_bytes_out','disk_free','lustre_read_bw','lustre_write_bw','nfsio_nread','nfsio_nwrite','ib_recv','ib_xmit','acc_mem_used','acc_power','clock','ipc','core_power','flops_any','flops_bf16','flops_sp','flops_dp','node_total_power','job_mem_used'])"
    ],
    "add_meta_if": [
      {
        "if": "name == 'mem_used' && meta.unit == 'kB'",
        "key": "unit",
        "value": "KiB"
      }
    ],
    "change_unit_prefix": {
      "name == 'mem_used'": "G",
      "name == 'acc_mem_used'": "G",
      "name == 'lustre_read_bw'": "M",
      "name == 'lustre_write_bw'": "M",
      "name == 'ib_recv'": "M",
      "name == 'ib_xmit'": "M",
      "name == 'disk_free'": "G",
      "name == 'net_bytes_in'": "M",
      "name == 'net_bytes_out'": "M",
      "name == 'nfsio_nread'": "M",
      "name == 'nfsio_nwrite'": "M",
      "name == 'job_mem_used'": "G"
    }
  },
  "normalize_units": true
}

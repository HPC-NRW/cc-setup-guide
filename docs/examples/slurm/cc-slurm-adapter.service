[Unit]
Description=ClusterCockpit Slurm adapter
Wants=network-online.target
After=network-online.target

[Service]
User=cc-slurm-adapter
Group=slurm
SupplementaryGroups=cc-slurm-adapter
WorkingDirectory=/opt/cc-slurm-adapter
ExecStart=/opt/cc-slurm-adapter/cc-slurm-adapter -daemon -config /etc/cc-slurm-adapter/config.json
RuntimeDirectory=cc-slurm-adapter
RuntimeDirectoryMode=0750
StateDirectory=cc-slurm-adapter
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=15s

[Install]
WantedBy=multi-user.target

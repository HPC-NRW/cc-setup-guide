{
  "add_tags": [
    {
      "key": "cluster",
      "value": "__CLUSTER__",
      "if": "*"
    }
  ],
  "interval_timestamp": false,
  "num_cache_intervals": 0,
  "hostname_tag": "hostname",
  "normalize_units": true,
  "process_messages": {
    "stage_order": [
      "add_tag",
      "rename",
      "rename_if",
      "drop_by_type",
      "drop_by_name",
      "drop_if",
      "add_meta",
      "change_unit_prefix",
      "normalize_unit"
    ],
    "hostname_tag": "hostname",
    "rename_messages": {
      "load_one": "cpu_load"
    },
    "drop_messages_if": [
      "!(name in ['cpu_load'])"
    ]
  }
}
